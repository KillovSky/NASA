cff-version: 1.2.0
message: >-
  Se você usar o @killovsky/nasa em pesquisas, publicações, projetos
  acadêmicos ou projetos derivados, por favor cite usando as informações
  abaixo. E obviamente, mencione a API da NASA que deu poder a esse projeto.

type: software
title: "@killovsky/nasa"
abstract: >-
  @killovsky/nasa é um cliente, sem dependências de produção, para o APOD
  (Astronomy Picture of the Day) da NASA. Escrito em TypeScript, funciona em
  ESM e CommonJS e tem uma CLI. Busca o APOD por data, o mais recente ou
  vários de uma vez, e pode baixar a imagem para o disco.

authors:
  - alias: "KillovSky"

repository-code: "https://github.com/KillovSky/NASA"
url: "https://www.npmjs.com/package/@killovsky/nasa"
license: MIT
version: "3.0.0"
date-released: "2026-11-15"

keywords:
  - nasa
  - apod
  - astronomy
  - astronomy-picture-of-the-day
  - space
  - api-client
  - typescript
  - nodejs
  - esm
  - commonjs
  - cli
  - zero-dependency

references:
  - type: website
    title: "APOD Feed and API User Guide"
    url: "https://science.nasa.gov/wp-json/wp/v2/apod-basic"
    notes: "API da NASA usada pelo cliente para buscar a Foto Astronômica do Dia."

  - type: software
    title: "TypeScript"
    url: "https://www.typescriptlang.org"
    notes: "Linguagem do projeto."

  - type: software
    title: "tsup"
    url: "https://tsup.egoist.dev"
    notes: "Empacotamento das versões ESM e CommonJS."
